{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeCut Local",
  "version": "0.1.0",
  "identifier": "net.freecut.local",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FreeCut Local",
        "width": 720,
        "height": 620,
        "minWidth": 620,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/uv"],
    "resources": {
      "../runtime/pyproject.toml": "runtime/pyproject.toml",
      "../runtime/uv.lock": "runtime/uv.lock",
      "../runtime/freecut_sidecar/*.py": "runtime/freecut_sidecar/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFNDczQTA1M0E0OEFENTgKUldSWXJVZzZCVHBIVG1Fbktwc1ltRnpteGU5b1gzTnFmU1ZBTnJBQk1tSWhnU3FVbzZOOWtiZDkK",
      "endpoints": [
        "https://github.com/walterlow/freecut/releases/download/freecut-local-updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
